
config at-webserver 'config'
	option enabled '1'
	# XGPV3 推荐 UBUS：经 QModem at-daemon 共享串口，不再独占
	option connection_type 'UBUS'
	option network_host '192.168.8.1'
	option network_port '20249'
	option network_timeout '10'
	option network_allow_wan '0'
	option network_restrict_access '0'
	# at-daemon 持有的 AT 串口（XGPV3 实测 /dev/ttyUSB1），务必与 QModem 实际打开的 at_port 一致
	option serial_port '/dev/ttyUSB1'
	option serial_port_custom '/dev/ttyUSB1'
	option serial_baudrate '115200'
	option serial_timeout '10'
	option serial_method 'TOM_MODEM'
	option serial_feature 'UBUS'
	option websocket_port '8765'
	option websocket_allow_wan '0'
	option websocket_auth_key ''
	option wechat_webhook ''
	option log_file ''
	option log_enabled '1'
	option log_level 'INFO'
	option notify_sms '1'
	option notify_call '1'
	option notify_memory_full '1'
	option notify_signal '1'
	option netmon_enabled '1'
	option netmon_interval '30'
	option schedule_auto_airplane_enable '0'
	option schedule_airplane_time '8:00'
